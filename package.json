{
  "name": "fluxe-suivi",
  "private": true,
  "description": "Fluxe Suivi : carnet de musculation (PWA). Ce fichier sert seulement aux tests automatiques.",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "verifier": "eslint js outils",
    "ranger": "prettier --write \"js/**/*.js\" \"outils/**/*.mjs\""
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
